@startuml
title Bookstore Backend - Diagrama de Classes

left to right direction
skinparam packageStyle rectangle
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

package "Domain" {
  enum CustomerProfile {
    NONE
    BRONZE
    SILVER
    GOLD
  }

  enum Region {
    SOUTHEAST
    OTHER
  }

  enum PaymentMethod {
    CREDIT_CARD
    PIX
  }

  enum PaymentStatus {
    PENDING
    APPROVED
    DECLINED
  }

  enum OrderStatus {
    CREATED
    PROCESSING
    CONFIRMED
    CANCELLED
    DELIVERED
    FINISHED
  }

  class AppError {
    +statusCode: number
  }

  class OrderStatusService {
    +assertOrderTransition(current: OrderStatus, next: OrderStatus): void
    +AUTO_ADVANCE_STEPS: [OrderStatus, OrderStatus][]
  }

  class RegionService {
    +getRegionByState(state: string): Region
  }
  note right of RegionService
    Valida as 27 UFs brasileiras
    antes de determinar a região.
  end note

  interface PricingInput {
    +subtotal: number
    +yearsAsCustomer: number
    +region: Region
  }

  interface PricingResult {
    +profile: CustomerProfile
    +discountRate: number
    +discount: number
    +shippingRate: number
    +shipping: number
    +total: number
  }

  class PricingService {
    +yearsSince(since: Date, now: Date): number
    +getCustomerProfile(years: number): object
    +calculatePricing(input: PricingInput): PricingResult
  }

  interface PaymentInput {
    +method: PaymentMethod
    +amount: number
    +customerId: string
  }

  interface CheckoutInput {
    +region: Region [0..1]
    +paymentMethod: PaymentMethod
    +cardId: string
    +deliveryAddress: object
  }
}

package "Models / Mongoose Schemas" {
  class Bank {
    +_id: ObjectId
    +name: string
    +code: string
    +createdAt: Date
    +updatedAt: Date
  }

  class Book {
    +_id: ObjectId
    +title: string
    +author: string
    +price: number
    +stock: number
    +createdAt: Date
    +updatedAt: Date
  }

  class Customer {
    +_id: ObjectId
    +name: string
    +email: string
    +passwordHash: string
    +createdAt: Date
  }

  class Card {
    +_id: ObjectId
    +customerId: ObjectId
    +bankId: ObjectId
    +holderName: string
    +last4: string
    +createdAt: Date
    +updatedAt: Date
  }

  class Account {
    +_id: ObjectId
    +customerId: ObjectId
    +balanceCents: number
    +createdAt: Date
    +updatedAt: Date
  }

  class Cart {
    +_id: ObjectId
    +customerId: ObjectId
    +items: CartItem[]
    +createdAt: Date
    +updatedAt: Date
  }

  class CartItem <<embedded>> {
    +bookId: ObjectId
    +quantity: number
  }

  class Order {
    +_id: ObjectId
    +customerId: ObjectId
    +idempotencyKey: string
    +items: OrderItem[]
    +region: Region
    +customerProfile: CustomerProfile
    +subtotal: number
    +discount: number
    +shipping: number
    +total: number
    +paymentMethod: PaymentMethod
    +paymentStatus: PaymentStatus
    +status: OrderStatus
    +paymentReference: string
    +cardId: ObjectId
    +cancellationDueAt: Date
    +deliveryAddress: DeliveryAddress
    +createdAt: Date
    +updatedAt: Date
  }

  class OrderItem <<embedded>> {
    +bookId: ObjectId
    +title: string
    +unitPrice: number
    +quantity: number
  }

  class DeliveryAddress <<embedded>> {
    +postalCode: string
    +street: string
    +number: string
    +complement: string
    +neighborhood: string
    +city: string
    +state: string
  }
}

package "Application Services" {
  class AuthService {
    +register(input: object): Promise<object>
    +login(input: object): Promise<object>
  }

  class BankService {
    +list(): Promise<Bank[]>
    +create(input: object): Promise<Bank>
    +getAccount(customerId: string): Promise<object>
    +deposit(customerId: string, amount: number): Promise<object>
    +authorize(customerId: string, amount: number, method: PaymentMethod, session?: ClientSession): Promise<object>
  }

  class CardService {
    +create(customerId: string, input: object): Promise<Card>
    +list(customerId: string): Promise<Card[]>
    +assertOwned(customerId: string, cardId: string): Promise<void>
    +toDto(card: Card): object
  }

  class CartService {
    +get(customerId: string): Promise<Cart>
    +add(customerId: string, bookId: string, quantity: number): Promise<Cart>
    +update(customerId: string, bookId: string, quantity: number): Promise<Cart>
    +remove(customerId: string, bookId: string): Promise<Cart>
  }

  class CatalogService {
    +list(): Promise<Book[]>
    +get(id: string): Promise<Book>
  }

  class PaymentService {
    +pay(input: PaymentInput, session?: ClientSession): Promise<object>
  }

  class OrderService {
    +preview(customerId: string, region: Region, now: Date): Promise<PricingResult>
    +checkout(customerId: string, input: CheckoutInput, idempotencyKey: string): Promise<Order>
    +list(customerId: string): Promise<Order[]>
    +get(customerId: string, id: string): Promise<Order>
    +cancelExpired(now: Date): Promise<number>
    +advanceOrders(): Promise<number>
    +processOrders(now: Date): Promise<object>
  }
}

package "Repositories" {
  class BankRepository {
    +findAll(): Promise<Bank[]>
    +findById(id: string): Promise<Bank>
    +create(data: object): Promise<Bank>
  }

  class AccountRepository {
    +findByCustomer(customerId: string): Promise<Account>
    +deposit(customerId: string, cents: number): Promise<Account>
    +debit(customerId: string, cents: number, session?: ClientSession): Promise<boolean>
  }

  class BookRepository {
    +findAll(): Promise<Book[]>
    +findById(id: string): Promise<Book>
    +decreaseStock(id: string, quantity: number, session?: ClientSession): Promise<boolean>
    +increaseStock(id: string, quantity: number, session?: ClientSession): Promise<boolean>
  }

  class CardRepository {
    +create(data: object): Promise<Card>
    +findByCustomer(customerId: string): Promise<Card[]>
    +findByIdForCustomer(cardId: string, customerId: string): Promise<Card>
  }

  class CartRepository {
    +findByCustomer(customerId: string, session?: ClientSession): Promise<Cart>
    +findRawByCustomer(customerId: string): Promise<Cart>
    +quantityOfBook(customerId: string, bookId: string): Promise<number>
    +addItem(customerId: string, bookId: string, quantity: number): Promise<Cart>
    +updateItem(customerId: string, bookId: string, quantity: number): Promise<Cart>
    +removeItem(customerId: string, bookId: string): Promise<boolean>
    +clear(customerId: string, session?: ClientSession): Promise<Cart>
  }

  class CustomerRepository {
    +findByEmail(email: string): Promise<Customer>
    +findById(id: string, session?: ClientSession): Promise<Customer>
    +create(data: object): Promise<Customer>
  }

  interface CreateOrderData {
    +customerId: string
    +idempotencyKey: string
    +items: OrderItem[]
    +subtotal: number
    +discount: number
    +shipping: number
    +total: number
  }

  class OrderRepository {
    +create(data: CreateOrderData, session: ClientSession): Promise<Order>
    +findByCustomerAndIdempotencyKey(customerId: string, key: string, session?: ClientSession): Promise<Order>
    +findByCustomer(customerId: string): Promise<Order[]>
    +findByIdForCustomer(orderId: string, customerId: string): Promise<Order>
    +updatePayment(orderId: string, data: object): Promise<Order>
    +findExpired(now: Date): Promise<Order[]>
    +cancelOneIfExpired(orderId: string, now: Date, session: ClientSession): Promise<Order>
    +advanceAll(from: OrderStatus, to: OrderStatus): Promise<number>
  }
}

' Dependências entre serviços e repositórios
AuthService --> CustomerRepository
BankService --> BankRepository
BankService --> AccountRepository
CardService --> CardRepository
CardService --> BankRepository
CartService --> CartRepository
CartService --> BookRepository
CatalogService --> BookRepository
PaymentService --> BankService
OrderService --> OrderRepository
OrderService --> CartRepository
OrderService --> BookRepository
OrderService --> PaymentService
OrderService --> PricingService
OrderService --> OrderStatusService
OrderService --> RegionService

' Relacionamentos persistidos (referências ObjectId do Mongoose)
Card "0..*" --> "1" Customer : customerId
Card "0..*" --> "1" Bank : bankId
Account "0..1" --> "1" Customer : customerId
Cart "0..1" --> "1" Customer : customerId
CartItem "0..*" --> "1" Book : bookId
Order "0..*" --> "1" Customer : customerId
Order "0..*" --> "0..1" Card : cardId
OrderItem "0..*" --> "1" Book : bookId

' Checkout usa uma ClientSession para transacionar pedido, estoque, saldo simulado e carrinho.
' O índice único (customerId, idempotencyKey) protege reenvios do checkout.
' CreateOrderData representa os campos necessários para registrar o pedido.

' Composição de subdocumentos embutidos
Cart "1" *-- "0..*" CartItem : items
Order "1" *-- "1..*" OrderItem : items
Order "1" *-- "1" DeliveryAddress : deliveryAddress

@enduml
