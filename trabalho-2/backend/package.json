    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.18.12",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^5.1.1",
    "mongodb-memory-server": "^10.2.3",
    "supertest": "^7.1.4",
    "tsuml2": "^0.11.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^5.1.1"
